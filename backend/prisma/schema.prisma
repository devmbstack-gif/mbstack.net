generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ContactInquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model ConsultancyRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  type        String
  budget      String
  packageName String?
  description String
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}
